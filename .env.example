# Expo app (public — bundled into the client)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Server-side only (Edge Function secrets / seed script — never in the app bundle)
SUPABASE_SERVICE_ROLE_KEY=
FOOTBALL_DATA_TOKEN=
FOOTBALL_DATA_COMPETITION=WC
# Bearer the pg_cron job sends to sync-results (openssl rand -hex 32);
# same value goes in Vault under the name 'service_role_key'
CRON_SECRET=

# Configured in Supabase Auth SMTP settings (dashboard), not in code
RESEND_API_KEY=
